# Settings for the test application. These are loaded by all of the bin scripts.
# Edit them to change how the process manager behaves, or override them on the
# command line (e.g. `SIDEKIQ_MAX_MEMORY=150m bin/run`).

# Number of sidekiq processes the manager forks.
SIDEKIQ_PROCESSES=3

# Restart a sidekiq process once it uses more than this much memory.
SIDEKIQ_MAX_MEMORY=100m

# How often the manager checks process memory. The default in the gem is 60
# seconds, which is a long time to sit and watch, so check every 5 seconds here.
SIDEKIQ_MEMORY_CHECK_INTERVAL=5

REDIS_PORT=28470

# Port for the dashboard.
PORT=9292
